{
    "type": "project",

    "repositories": [{
        "type": "path",
        "url": "../framework",
        "options": {
            "symlink": true
        }
    }, {
        "type": "path",
        "url": "modules/guestbook",
        "options": {
            "symlink": true
        }
    }, {
        "type": "path",
        "url": "modules/theme",
        "options": {
            "symlink": true
        }
    }],

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require": {
        "zubzet/example-guestbook": "^0.1",
        "zubzet/example-theme": "^0.1",
        "zubzet/framework": "*@dev"
    },

    "require-dev": {
        "phpunit/php-code-coverage": "9.*"
    },

    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "GHSA-2jx3-65f3-xr8r": {
                    "apply": "block",
                    "reason": "otphp 11 requires PHP 8.1+, PHP 8.0 stays on 10.x"
                },
                "GHSA-g7m4-839x-ch6v": {
                    "apply": "block",
                    "reason": "otphp 11 requires PHP 8.1+, PHP 8.0 stays on 10.x"
                }
            }
        }
    }
}
