{
    "type": "project",

    "repositories": [{
        "type": "path",
        "url": "../framework",
        "options": {
            "symlink": true
        }
    }, {
        "type": "path",
        "url": "modules/guestbook",
        "options": {
            "symlink": true
        }
    }, {
        "type": "path",
        "url": "modules/theme",
        "options": {
            "symlink": true
        }
    }],

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require": {
        "zubzet/example-guestbook": "^0.1",
        "zubzet/example-theme": "^0.1",
        "zubzet/framework": "*@dev"
    },

    "require-dev": {
        "phpunit/php-code-coverage": "9.*"
    },

    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "PKSA-g499-cm4q-v35y": {
                    "apply": "block",
                    "reason": "symfony/filesystem 6.4.50+ requires PHP 8.1+, PHP 8.0 stays on 6.0"
                }
            }
        }
    }
}
